<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Financial data is managed by the versioned JSON export/import flow. -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="recovery/" />
    </cloud-backup>
    <device-transfer>
        <!-- Never restore a DB file independently from its active-copy registry. -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="recovery/" />
    </device-transfer>
</data-extraction-rules>
