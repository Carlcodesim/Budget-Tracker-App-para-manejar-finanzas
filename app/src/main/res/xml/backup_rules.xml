<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      Financial data is exported/restored explicitly through BackupManager JSON.
      Do not let OS backup restore the historical Room file independently of
      the active-copy registry; that could silently select an old data generation.
      The complete recovery workspace is also intentionally excluded.
    -->
    <exclude domain="database" path="." />
    <exclude domain="file" path="recovery/" />
</full-backup-content>
